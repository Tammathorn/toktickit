// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).
//
// Lab 3 models follow docs/lab-03/specification.md section 7 exactly.
// Prisma's default table naming is accepted throughout: no @@map, no @map.
// Never run `prisma migrate reset` — it destroys the seed data (L2 C-37).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — L2 C-23, C-69, C-70.
// TicketStatus carries eight values in Lab 3, all of them reachable. OPEN,
// WAITING_FOR_REQUESTER and REOPENED are added by their own migration, before
// the migration that uses them: PostgreSQL cannot use a new enum value in the
// transaction that adds it (C-70).
// ---------------------------------------------------------------------------
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// ---------------------------------------------------------------------------
// Issue 3 (Lab 1) — IT request categories. Seeded by prisma/seed.ts.
// Lab 2 adds isActive (C-05). GET /api/categories keeps its {id, name} shape
// in id order, so the Lab 1 Supertest assertion continues to pass.
// ---------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 2 — the service, application, device or platform a Ticket affects.
// A flat list, never scoped to a Category (C-24).
// ---------------------------------------------------------------------------
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 3 — the User, renamed in place from the Lab 2 RequesterUser (C-67).
// The rename is an ALTER TABLE, so every id, and therefore every
// Ticket.requesterId, survives untouched.
//
// passwordHash is nullable on purpose: the migration cannot compute a scrypt
// hash, so every migrated row arrives with NULL and mustChangePassword true.
// A NULL hash can never authenticate and returns the same generic 401 as a
// wrong password (C-72, BR-17). Format and comparison are C-53's.
// ---------------------------------------------------------------------------
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  role               UserRole @default(REQUESTER)
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  tickets       Ticket[]        @relation("TicketRequester")
  ownedTickets  Ticket[]        @relation("TicketOwner")
  sessions      Session[]
  publicComments PublicComment[]
  internalNotes InternalNote[]
}

// ---------------------------------------------------------------------------
// Lab 3 — the Session (C-54, C-55). The 32-byte token travels in the
// tt_session cookie; only its SHA-256 is stored here, so a leaked database
// row cannot be replayed as a session. expiresAt is createdAt + 8 hours,
// absolute, with no sliding renewal; a row found expired by a lookup is
// deleted there and then (C-96).
// ---------------------------------------------------------------------------
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

  // Deactivation, a role change and a new initial password each end all of a
  // user's sessions (BR-24): that is a delete by userId.
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Lab 2 — the Ticket.
//
// ticketNumber is nullable because the six digits are this row's own
// autoincrement id, which does not exist until the insert completes. Create and
// update run inside one transaction (C-49), so the column is never null outside
// that transaction. PostgreSQL permits repeated nulls under a unique
// constraint, so nullable and @unique do not conflict.
//
// Lab 3 adds the workflow columns: itPriority becomes NOT NULL, backfilled
// from requestedPriority and set from it on create (C-71); ownerId is the
// zero-or-one Ticket Owner (BR-45); requesterResolvedAt is the C-76 flag, a
// timestamp rather than a status, so BR-05 keeps status changes with IT Staff.
// ---------------------------------------------------------------------------
model Ticket {
  id                  Int               @id @default(autoincrement())
  ticketNumber        String?           @unique
  requesterId         Int
  categoryId          Int
  relatedSystemId     Int
  ownerId             Int?
  summary             String
  description         String            @db.Text
  requestedPriority   RequestedPriority @default(MEDIUM)
  itPriority          RequestedPriority
  currentStatus       TicketStatus      @default(NEW)
  requesterResolvedAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  requester      User            @relation("TicketRequester", fields: [requesterId], references: [id])
  owner          User?           @relation("TicketOwner", fields: [ownerId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  relatedSystem  RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]

  // Every My Tickets query is scoped to one Requester before anything else
  // happens (BR-22), so each Lab 2 index is led by requesterId. They are kept:
  // My Tickets still issues exactly the query they were chosen for.
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([requesterId, currentStatus])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  // The queue has no requester scope at all, so none of the four serves it.
  // Every queue query starts from a status set (BR-72), so currentStatus leads
  // each of these three.
  @@index([currentStatus, itPriority, createdAt])
  @@index([currentStatus, ownerId])
  @@index([currentStatus, categoryId])
}

// ---------------------------------------------------------------------------
// Lab 2 — the Attachment.
//
// Soft removal is a flag plus two nullable companions rather than a separate
// archive table: the metadata must stay visible on Ticket Detail (BR-50), so the
// row must remain in the table the detail query already reads.
// ---------------------------------------------------------------------------
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removalReason    String?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  // Ticket Detail always reads a Ticket's attachments split by removal state
  // (BR-50), and the five-active check (BR-44) counts on exactly this pair.
  @@index([ticketId, isRemoved])
}

// ---------------------------------------------------------------------------
// Lab 3 — Public Comments and Internal Notes, two tables rather than one
// table with a visibility flag (C-73): a notes query structurally cannot leak
// into the comments endpoint.
//
// Neither carries updatedAt, deletedAt or an edit path. Append-only is
// enforced by the absence of the column as much as by the absence of a route.
// ---------------------------------------------------------------------------
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  // Read per Ticket, newest first (BR-67).
  @@index([ticketId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  // Read per Ticket, newest first (BR-67).
  @@index([ticketId, createdAt])
}
