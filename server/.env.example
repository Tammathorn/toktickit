# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000
# Lab 2 attachment storage (C-17). Relative paths resolve from the server directory.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Lab 3 CSRF Origin check (C-58). The origin the browser client is served from;
# a POST, PATCH or DELETE carrying any other Origin header is refused 403.
CLIENT_ORIGIN="http://localhost:5173"
# ---------------------------------------------------------------------------
# Lab 5 - cloud settings (docs/labs/lab-05/deployment.md 2 lists every one).
# All optional locally; leave them out for `npm run dev`.
# disk (default) keeps attachments under UPLOAD_DIR; database keeps them in
# Attachment.content. The production image sets database (Cloud Run has no
# lasting disk).
ATTACHMENT_STORAGE=disk
# Where the built React app is, served by this server when NODE_ENV=production.
# CLIENT_DIST_DIR=../client/dist
# Production seed only (NODE_ENV=production). Locally the seed uses the
# documented development passwords instead. On Cloud Run: Secret Manager.
# ADMIN_PASSWORD=
# SEED_DEMO_DATA=false
# DEMO_USER_PASSWORD=
# Set by the image build (Dockerfile ARG); GET /api/version returns it.
# APP_COMMIT=
