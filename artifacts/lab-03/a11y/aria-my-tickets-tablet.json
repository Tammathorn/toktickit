{
  "screen": "my-tickets",
  "viewport": "tablet",
  "url": "/tickets",
  "unnamedInteractive": [],
  "ariaSnapshot": [
    "- banner:",
    "  - navigation \"Main navigation\":",
    "    - link \"TokTickIT\":",
    "      - /url: /tickets",
    "    - list:",
    "      - listitem:",
    "        - link \"My Tickets\":",
    "          - /url: /tickets",
    "      - listitem:",
    "        - link \"Create Ticket\":",
    "          - /url: /tickets/new",
    "    - text: Siriporn Chaiyo Requester",
    "    - button \"Log Out\"",
    "- main:",
    "  - region \"My Tickets\":",
    "    - heading \"My Tickets\" [level=1]",
    "    - search \"Search and filter tickets\":",
    "      - text: Search",
    "      - searchbox \"Search\"",
    "      - text: Category",
    "      - combobox \"Category\":",
    "        - option \"All categories\" [selected]",
    "        - option \"Account and Access\"",
    "        - option \"Hardware\"",
    "        - option \"Software\"",
    "        - option \"Network\"",
    "      - text: Related System",
    "      - combobox \"Related System\":",
    "        - option \"All related systems\" [selected]",
    "        - option \"Email\"",
    "        - option \"Campus Wi-Fi\"",
    "        - option \"VPN\"",
    "        - option \"LEB2 App\"",
    "        - option \"Grade Submission App\"",
    "        - option \"Printer\"",
    "        - option \"Corporate Laptop\"",
    "      - text: Current Status",
    "      - combobox \"Current Status\":",
    "        - option \"All statuses\" [selected]",
    "        - option \"New\"",
    "        - option \"Open\"",
    "        - option \"In Progress\"",
    "        - option \"Waiting for Requester\"",
    "        - option \"Resolved\"",
    "        - option \"Closed\"",
    "        - option \"Reopened\"",
    "        - option \"Cancelled\"",
    "      - text: Sort",
    "      - combobox \"Sort\":",
    "        - option \"Newest first\" [selected]",
    "        - option \"Oldest first\"",
    "        - option \"Ticket Number, ascending\"",
    "        - option \"Ticket Number, descending\"",
    "        - option \"Ticket Summary, A to Z\"",
    "        - option \"Ticket Summary, Z to A\"",
    "        - option \"Current Status, A to Z\"",
    "        - option \"Current Status, Z to A\"",
    "    - region \"Ticket list\""
  ]
}
