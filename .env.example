# Used by docker-compose.yml only. Copy to ".env" (git-ignored) and replace
# every value. Placeholders only - never commit real values.
# On Cloud Run these come from Secret Manager instead (deployment.md 2).

# Password of the local PostgreSQL container's toktickit user.
POSTGRES_PASSWORD=change-me-local-db-password
# First Administrator (panida.s@example.ac.th); must be changed at first sign-in.
# Needs 10+ characters with upper, lower, digit and symbol (password policy).
ADMIN_PASSWORD=Change-Me-Admin-1
# Every demo persona (Requesters, IT Staff, first-login account).
DEMO_USER_PASSWORD=Change-Me-Demo-1
# true = also seed the demo personas and tickets; false = Administrator only.
SEED_DEMO_DATA=true
